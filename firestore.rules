rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    // Auth tokens NEVER contain custom claims. We must check email or lookup doc.
    function isAdmin() { 
      return isVerified() && (
        request.auth.token.email == "dnacultfitness@gmail.com" || 
        request.auth.token.email == "admin@dnacultfitness.com"
      );
    }
    
    function isUser(uid) { return isVerified() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // -------------------------------------------------------------------------
    // PUBLIC ACCESS
    // -------------------------------------------------------------------------
    
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true; // Allow guests to submit reviews
      allow update, delete: if isAdmin();
    }

    match /gymServices/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /membershipPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // RESTRICTED ACCESS
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isUser(userId) || isAdmin() || (isVerified() && resource.data.assignedTrainerUid == request.auth.uid);
      allow list: if isAdmin() || (isVerified() && resource.data.assignedTrainerUid == request.auth.uid);
      allow create: if isUser(userId);
      allow update: if isUser(userId) || isAdmin();
      
      match /details/{detailId} {
        allow read: if isUser(userId) || isAdmin() || (isVerified() && get(/databases/$(database)/documents/users/$(userId)).data.assignedTrainerUid == request.auth.uid);
        allow write: if isUser(userId) || isAdmin();
      }
    }

    match /trainers/{trainerId} {
      allow get, list: if isVerified();
      allow write: if isAdmin();
    }

    match /memberships/{membershipId} {
      allow read: if isAdmin() || (isVerified() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(resource.data.userId)).data.assignedTrainerUid == request.auth.uid));
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
    }

    match /aiPlans/{planId} {
      allow read: if isAdmin() || (isVerified() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(resource.data.userId)).data.assignedTrainerUid == request.auth.uid));
      allow write: if isAdmin() || (isVerified() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(resource.data.userId)).data.assignedTrainerUid == request.auth.uid));
    }

    match /planApprovalRequests/{requestId} {
      allow create: if isVerified();
      allow read: if isAdmin() || (isVerified() && (resource.data.trainerId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow update: if isAdmin() || (isVerified() && resource.data.trainerId == request.auth.uid);
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin() || (isVerified() && (resource.data.trainerId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if isVerified();
      allow update, delete: if isAdmin() || (isVerified() && resource.data.trainerId == request.auth.uid);
    }

    match /weeklyReports/{reportId} {
      allow read: if isAdmin() || (isVerified() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(resource.data.userId)).data.assignedTrainerUid == request.auth.uid));
      allow create: if isVerified() && incoming().userId == request.auth.uid;
    }

    match /dailyWorkouts/{workoutId} {
      allow read: if isAdmin() || (isVerified() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(resource.data.userId)).data.assignedTrainerUid == request.auth.uid));
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || isVerified(); // Allow system or trainers to create notifications
    }

    // -------------------------------------------------------------------------
    // DEFAULT DENY
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
